# Fins de ligne Linux pour tout ce qui s'execute dans un conteneur (AH-09).
# Sans cela, Git sous Windows sort ces fichiers en CRLF et les conteneurs
# echouent avec « exec /entrypoint.sh: no such file or directory ».
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.conf          text eol=lf
*.env.example   text eol=lf
.env.*.example  text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sql           text eol=lf
*.bat text eol=crlf
