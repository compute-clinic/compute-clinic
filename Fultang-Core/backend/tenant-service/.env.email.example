# Identifiants SMTP du service des etablissements (AH-12).
# Copier ce fichier en .env.email (le script demarrer.sh le fait tout seul).
# Laisses vides : le service demarre et les e-mails s'affichent dans les
# journaux du conteneur (backend console), rien n'est envoye.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@fultang.local
